<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finder</title>
</head>
<body>
     <h2>Edit details </h2>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT"> 
        <input name="listing[title]" value="<%= listing.title %>">
        <br><br>
        <input name="listing[description]" value="<%= listing.description %>">
        <br><br>
        <input name="listing[image]" value="<%= listing.name %>">
        <br><br>
        <input name="listing[price]" value="<%= listing.price %>">
        <br><br>
        <input name="listing[location]" value="<%= listing.location %>">
        <br><br>
        <input name="listing[country]" value="<%= listing.country %>">
        <br><br>

        <button>Add</button>
    </form>
</body>
</html>