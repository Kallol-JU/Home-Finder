    color: #6c757d;
    font-weight: 500;
    border-left: 3px solid transparent; 
    padding-left: 1rem;
}

.privacy-nav .nav-link:hover {
    color: #212529; 
    border-left: 3px solid #6c757d;
}

.privacy-nav .nav-link.active {
