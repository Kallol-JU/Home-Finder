<% layout("./layouts/boilerplate.ejs") %>

<body>

    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h2>Listing Details: </h2>
        </div>
   

    <div class="card col-6 offset-2">
        <img src="<%= listing.image.url %>" class="card-img-top show-img mb-1" alt="<%= listing.title %>'s image">
        <div class="card-body">
            <p class="card-text">
                <b> <%= listing.title %> </b> <br>
                <%=listing.description %> <br>
                &#8377; <%= listing.price.toLocaleString("en-IN") %> <br>
                <%=listing.location %> <br>
                <%= listing.country %>
            </p>
        </div>
    </div>
    <br>
    </div>

    <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark add-btn col-1 offset-2">Edit</a>
    <br>
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark offset-4">Delete</button>
    </form>
    </div>

</body>
