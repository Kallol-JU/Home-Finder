<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finder</title>
</head>
<body>

    <h2>Add the place details </h2>
    <form method="POST" action="/listings"> <!--so that the filled form gets added to the listings page -->
        <input name="listing[title]" placeholder="enter title here">
        <br><br>
        <textarea name="listing[description]" placeholder="enter description here"></textarea>
        <br><br>
        <input name="listing[image]" placeholder="enter image url here">
        <br><br>
        <input name="listing[price]" placeholder="enter price here" type="number">
        <br><br>
        <input name="listing[location]" placeholder="enter location here">
        <br><br>
        <input name="listing[country]" placeholder="enter country here">
        <br><br>

        <button>Add</button>
    </form>
</body>
</html>